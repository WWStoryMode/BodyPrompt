# macOS
.DS_Store

# editors
.vscode/
.idea/

# node / vite (frontend/app)
node_modules/
dist/
.vite/
*.log

# python (service/)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
build/
*.egg-info/
.env

# What the service remembers (v3 Stage C). Motions are regenerable and can run to hundreds
# of MB; a session file, which is the writer's own copy, is exported deliberately instead.
service/.motions/

# Model weights: large, and SnapMoGen's are under Snap Inc.'s non-commercial licence,
# which is not this repository's to redistribute. See the README in that directory.
inference/snapmogen-worker/checkpoints/*
!inference/snapmogen-worker/checkpoints/README.md

# Language of Motion's weights are Apache-2.0 and freely downloadable, but they are 2 GB;
# the SMPL-X body model beside them is MPI-licensed and not ours to redistribute at all.
inference/language-of-motion-worker/checkpoints/*
!inference/language-of-motion-worker/checkpoints/README.md
