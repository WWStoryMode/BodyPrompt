# Which model comes from where.
#
# A URL is a worker — and a container on this machine and a GPU in another building are
# configured identically, so moving a model off this box is a change to one line here and
# to no code at all. Unset, or "fixture", means the hand-authored stub.
#
# Fixture mode (works without CUDA): leave all three unset.
#
# Local GPU mode: point each real model at its worker. Language of Motion has no worker
# yet, so leaving it unset keeps it an honest fixture.
# BODYPROMPT_MODEL_KIMODO=http://kimodo-worker:8010
# BODYPROMPT_MODEL_SNAPMOGEN=http://snapmogen-worker:8011
# BODYPROMPT_MODEL_LANGUAGE_OF_MOTION=http://lom-worker:8012

# Language of Motion needs the SMPL-X body model, which is behind an MPI registration a
# human has to pass (https://smpl-x.is.tue.mpg.de/). Point this at the directory CONTAINING
# smplx/SMPLX_NEUTRAL_2020.npz. See inference/language-of-motion-worker/checkpoints/README.md.
# LOM_SMPLX_HOST=/path/to/smplx_models

# Remote workers take a token, and can override the local/remote guess:
# BODYPROMPT_MODEL_SNAPMOGEN=https://gpu.example.com/snapmogen
# BODYPROMPT_MODEL_SNAPMOGEN_TOKEN=
# BODYPROMPT_MODEL_SNAPMOGEN_HOSTING=remote

# v1 local-GPU mode. HF_TOKEN is needed by the Kimodo worker for the gated Llama-3-8B
# text encoder; never put it in a shell command, and never commit this file.
# HF_TOKEN=hf_replace_with_a_fine_grained_read_token
# BODYPROMPT_DIFFUSION_STEPS=100

# What the service remembers (v3 Stage C). A seeded request replays out of the store
# without the model that answered it — including with its worker stopped. Compose points
# this at a named volume; "off" keeps nothing. The limit is a count of motions, evicted
# least-recently-used first; a session file exported from the instrument is the writer's
# own copy and is never affected by eviction.
# BODYPROMPT_STORE_LIMIT=500

# Legacy, still honoured: translated into BODYPROMPT_MODEL_KIMODO when that is not set.
BODYPROMPT_BACKEND=stub
# BODYPROMPT_BACKEND=kimodo
